{
    "[plaintext]": {
        // `textDocument/onTypeFormatting` リクエストを有効にするにはコメントを解除します
        "editor.formatOnType": true
    },
    // 使用されている Python 環境をオーバーライドするにはコメントを解除します。
    // "pygls.server.pythonCommand": ["uv", "run", "--no-project", "--prerelease=allow", "--with", "pygls==2.0a2", "python"],
    //
    // VSCodeでサーバープロセスをデバッグするにはコメントを解除します
    // "pygls.server.debug": true,
    //
    // デバッガをホストする場所を変更するにはコメントを解除します
    // "pygls.server.debugHost": "localhost",
    // "pygls.server.debugPort": 5678,
    //
    // 起動するLSPサーバーを制御する
    "pygls.server.launchScript": "rename.py", // これは `pygls.server.cwd` からの相対パスです
    "pygls.server.cwd": "${workspaceFolder}/examples/servers",
    //
    // コメントを解除すると、クライアントとサーバー間のすべてのLSPメッセージが表示されます。
    "pygls.trace.server": "verbose",
    //
    // VSCode が LSP サーバーに問い合わせるドキュメントを制御します
    "pygls.client.documentSelector": [
        {
            "language": "plaintext"
        }
    ],
    // "pygls.jsonServer.exampleConfiguration": "some value here",
    //
    // 以下は標準の VSCode プロジェクト設定です。
    "python.testing.pytestArgs": [
        "."
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
}
